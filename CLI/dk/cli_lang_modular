################################################################################
# QuickBox Pro - Modulært Sprogsystem
# 
# Denne fil fungerer som en bridge mellem systemet og de modulære oversættelsesfiler.
# Den indlæser alle de individuelle sprogmoduler for at give et samlet
# interface til CLI-systemet.
#
# Modulstruktur:
# - core.sh      - Kerne systemoperationer (låse, rensning, grundlæggende funktioner)
# - apt.sh       - APT pakkehåndtering
# - software.sh  - Software installation/fjernelse/opdatering operationer
# - ssl.sh       - SSL/LetsEncrypt certifikathåndtering
# - dns.sh       - DNS legitimationshåndtering
# - users.sh     - Brugerhåndteringsoperationer
# - vpn.sh       - VPN/WireGuard operationer
# - database.sh  - Databasehåndtering (MySQL/SQLite)
# - updater.sh   - Systemopdateringsoperationer
# - manager.sh   - Software manager (backup/gendannelse/rollback)
# - help.sh      - Hjælp og fejlhåndtering
################################################################################

# Få mappen hvor dette script er placeret
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Indlæs alle modulære sprogfiler
# Kerne systemoperationer
if [[ -f "${SCRIPT_DIR}/cli/core.sh" ]]; then
  source "${SCRIPT_DIR}/cli/core.sh"
fi

# APT pakkehåndtering
if [[ -f "${SCRIPT_DIR}/cli/apt.sh" ]]; then
  source "${SCRIPT_DIR}/cli/apt.sh"
fi

# Softwarehåndtering
if [[ -f "${SCRIPT_DIR}/cli/software.sh" ]]; then
  source "${SCRIPT_DIR}/cli/software.sh"
fi

# SSL/LetsEncrypt operationer
if [[ -f "${SCRIPT_DIR}/cli/ssl.sh" ]]; then
  source "${SCRIPT_DIR}/cli/ssl.sh"
fi

# DNS legitimationshåndtering
if [[ -f "${SCRIPT_DIR}/cli/dns.sh" ]]; then
  source "${SCRIPT_DIR}/cli/dns.sh"
fi

# Brugerhåndtering
if [[ -f "${SCRIPT_DIR}/cli/users.sh" ]]; then
  source "${SCRIPT_DIR}/cli/users.sh"
fi

# VPN/WireGuard operationer
if [[ -f "${SCRIPT_DIR}/cli/vpn.sh" ]]; then
  source "${SCRIPT_DIR}/cli/vpn.sh"
fi

# Databasehåndtering
if [[ -f "${SCRIPT_DIR}/cli/database.sh" ]]; then
  source "${SCRIPT_DIR}/cli/database.sh"
fi

# Systemopdatering
if [[ -f "${SCRIPT_DIR}/cli/updater.sh" ]]; then
  source "${SCRIPT_DIR}/cli/updater.sh"
fi

# Software manager
if [[ -f "${SCRIPT_DIR}/cli/manager.sh" ]]; then
  source "${SCRIPT_DIR}/cli/manager.sh"
fi

# Hjælp og fejlhåndtering
if [[ -f "${SCRIPT_DIR}/cli/help.sh" ]]; then
  source "${SCRIPT_DIR}/cli/help.sh"
fi

# Software adgangsinformation
if [[ -f "${SCRIPT_DIR}/cli/software_access.sh" ]]; then
  source "${SCRIPT_DIR}/cli/software_access.sh"
fi

# Software konfiguration
if [[ -f "${SCRIPT_DIR}/cli/software_config.sh" ]]; then
  source "${SCRIPT_DIR}/cli/software_config.sh"
fi

# WireGuard specifikke operationer
if [[ -f "${SCRIPT_DIR}/cli/wireguard.sh" ]]; then
  source "${SCRIPT_DIR}/cli/wireguard.sh"
fi

# WebSocket Daemon operationer
if [[ -f "${SCRIPT_DIR}/cli/wsd.sh" ]]; then
  source "${SCRIPT_DIR}/cli/wsd.sh"
fi

# Diverse hjælpeprogrammer
if [[ -f "${SCRIPT_DIR}/cli/misc.sh" ]]; then
  source "${SCRIPT_DIR}/cli/misc.sh"
fi

################################################################################
# Legacy Kompatibilitetsfunktioner
# 
# Disse funktioner bevarer bagudkompatibilitet med den oprindelige cli_lang
# filstruktur. De omdirigerer til de passende modulære funktioner.
################################################################################

# Legacy funktionsmapping for bagudkompatibilitet
# Dette sikrer at eksisterende kode fortsætter med at virke mens vi overgår
# til det nye modulære system

# Eksempel på legacy funktionsmapping:
# quickbox::lang::install::header() -> quickbox::lang::install::header() (i software.sh)
# quickbox::lang::lecert::dns::provider::valid() -> quickbox::lang::lecert::dns::provider::valid() (i ssl.sh)

################################################################################
# Modul Indlæsningsstatus
################################################################################
quickbox::lang::modules::loaded() {
  declare text="Modulært sprogsystem indlæst succesfuldt"
  quickbox::dashboard::log "${text}"
}

quickbox::lang::modules::error() {
  declare text="Advarsel: Nogle sprogmoduler kunne ikke indlæses"
  quickbox::dashboard::log "${text}"
}

################################################################################
# Modul Validering
################################################################################
quickbox::lang::modules::validate() {
  local missing_modules=()
  local required_modules=(
    "core.sh"
    "apt.sh"
    "software.sh"
    "ssl.sh"
    "dns.sh"
    "users.sh"
    "vpn.sh"
    "database.sh"
    "updater.sh"
    "manager.sh"
    "help.sh"
    "software_access.sh"
    "software_config.sh"
    "wireguard.sh"
    "misc.sh"
    "wsd.sh"
  )
  
  for module in "${required_modules[@]}"; do
    if [[ ! -f "${SCRIPT_DIR}/cli/${module}" ]]; then
      missing_modules+=("${module}")
    fi
  done
  
  if [[ ${#missing_modules[@]} -gt 0 ]]; then
    declare text="Manglende sprogmoduler: ${missing_modules[*]}"
    quickbox::dashboard::log "${text}"
    return 1
  fi
  
  return 0
}

# Valider moduler ved indlæsning
if ! quickbox::lang::modules::validate; then
  quickbox::lang::modules::error
fi 